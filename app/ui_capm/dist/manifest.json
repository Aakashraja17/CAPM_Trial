{
	"sap.app": {
		"id": "com.capmlearn.uicapm",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"_version": "2.0",
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/catalog/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.01"
				}
			}
		}
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.capmlearn.uicapm.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"synchronizationMode": "None",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"controlAggregation": "pages",
				"controlId": "app",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"viewPath": "com.capmlearn.uicapm.view",
				"async": true
			},
			"routes": [
				{
					"name": "RouteView1",
					"pattern": ":?query:",
					"target": [
						"TargetView1"
					]
				},
				{
					"name": "RouteViewDetail",
					"pattern": "RouteViewDetail/{ID}",
					"target": [
						"TargetViewDetail"
					]
				}
			],
			"targets": {
				"TargetView1": {
					"viewId": "View1",
					"viewName": "View1",
					"viewType": "XML"
				},
				"TargetViewDetail": {
					"viewId": "Detailview",
					"viewName": "Detailview",
					"viewType": "XML"
				}
			}
		},
		"rootView": {
			"viewName": "com.capmlearn.uicapm.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	}
}